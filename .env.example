# Database — local PostgreSQL (recommended for development)
# When you go live (~70–80% done), restore a backup to your cloud/VPS database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ws_computer_city?schema=public"

# NextAuth.js
# Generate with: openssl rand -base64 32
# Required for admin login. Put the real value only in .env, never in git.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# One-time password used only when seeding a new admin. Rotate it after the first login.
ADMIN_INITIAL_PASSWORD=""

# App environment: development | staging | production
# production turns on HSTS. Leave this as development until the domain is live.
APP_ENV="development"

# Public origin. Change this to https://your-domain when you buy it.
# Do not commit a real .env. Copy this file to .env.local.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="LogicBay BD"

# Payment webhook. Generate a long random string. Never commit the real value.
# The checkout provider (or a staging script) signs the raw body with HMAC-SHA256.
PAYMENT_WEBHOOK_SECRET=""

# Transactional email (Resend). Leave blank locally; mail is logged instead.
# After the domain exists, add SPF, DKIM, and DMARC. See docs/LAUNCH.md.
RESEND_API_KEY=""
SMTP_FROM="LogicBay BD <orders@your-domain>"
# Public feedback form is delivered here.
FEEDBACK_TO_EMAIL="wadudshuvro1993@gmail.com"
# Every new order is emailed here (full customer, address and item details).
# Fastest setup: Gmail SMTP below (SMTP_HOST="smtp.gmail.com", SMTP_USER=your gmail,
# SMTP_PASSWORD=a Google App Password, 16 letters, not your normal password).
ORDER_NOTIFY_EMAIL="wadudshuvro1993@gmail.com"

# Sentry. Leave blank until you create a project. Do not paste a DSN into source files.
SENTRY_DSN=""

# Optional CDN / remote image hosts, comma-separated. Local photos stay in /uploads.
IMAGE_REMOTE_HOSTS="placehold.co,utfs.io"
# Optional — only if you create a Facebook App for catalog/pixel
NEXT_PUBLIC_FB_APP_ID=""

# File Upload (Choose one)
# Option 1: AWS S3
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME=""
AWS_REGION="ap-south-1"
AWS_CDN_DOMAIN=""

# Option 2: UploadThing (Recommended for easy start)
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# Redis. Production rate limits use this shared sliding window across app servers.
# Leave blank in local dev to use the in-process window. Cart and checkout stay open if Redis is down.
REDIS_URL="redis://localhost:6379"

# Search (Optional)
# Typesense
TYPESENSE_HOST=""
TYPESENSE_PORT="443"
TYPESENSE_PROTOCOL="https"
TYPESENSE_API_KEY=""

# Monitoring (Optional)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Email (Optional - for order notifications)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@wscomputercity.com"

# Payment Gateway (For future implementation)
# SSL Commerz (Bangladesh)
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_LIVE="false"

# bKash
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_IS_LIVE="false"

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=""

# AI Product Advisor (Smart Product Q&A)
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional model override (default: gemini-3.6-flash — supports tool calling)
AI_MODEL="gemini-3.6-flash"
